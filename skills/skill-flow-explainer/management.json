  "installationLifecycle": {
    "agentNeutral": true,
    "skillRequired": true,
    "updateRequiresSkillSync": true,
    "required_components": [
      "cli",
      "skill"
    ],
    "installGuide": "INSTALL.md",
    "updateGuide": "UPDATE.md",
    "targetRequired": true,
    "hostRegistrationRequired": true,
    "installationMode": "copy",
    "sharedLinksAllowed": false,
    "isolatedRuntimeRequired": true,
    "install": "Resolve current host exact Skill directory, invoke skill install, verify hashes, load Skill.",
    "update": "Explicit exact-version update install activates target-owned runtime; bootstrap npm CLI remains separate. Invoke activeRuntime thereafter.",
    "verification": "Verify CLI/manifest/receipt and host discovery independently."
  },
  "automaticUpdates": {
    "enabledByDefault": true,
    "intervalHours": 24,
    "timeoutMs": 2500,
    "trigger": "prepare or collect",
    "configuration": "SKILL_FLOW_CACHE_DIR selects cache storage; detection only",
    "disable": "SKILL_FLOW_UPDATE_CHECK=0",
    "recovery": "Offline retains current runtime; use update status after uncertain installation.",
    "defaultMode": "notify",
    "installation": "explicit-authorization"
  },
  "supportedOperatingSystems": [
    "macos",
    "windows",
    "linux"
  ],
  "authentication": "none for analysis; npm registry/network for updates"
